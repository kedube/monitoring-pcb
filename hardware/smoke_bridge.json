{
  "name": "smoke_bridge", "title": "Smoke/CO alarm Wi-Fi + Matter bridge (ESP32-C6, 120 VAC)", "revision": "A",
  "requirements": {
    "function": "Listens to the interconnect wire of hardwired 120 V smoke/CO alarms (like the Zooz ZEN55) and reports alarms over Wi-Fi or Matter (Wi-Fi or Thread). Never drives the interconnect.",
    "size": "as small as practical for an electrical box: slim board for a single-gang box or 4-inch round/octagon box",
    "power": "120 VAC line via a sealed encapsulated AC-DC module (HLK-PM01, 5 V 3 W; designed to UL/CE, not UL-recognized) with T1.25A fuse (100 A breaking) + 470 V MOV; USB-C 5 V for bench programming only, diode-isolated from the line supply",
    "io": "3-position 300 V screw terminal (L, N, interconnect) with wire entry on the left board edge; USB-C on the bottom edge; BOOT button; status LED",
    "isolation": "5 mm no-copper barrier between the 120 V side and the low-voltage side; interconnect read through an optocoupler (LTV-817S); 120 V parts kept in fixed positions on the left",
    "radio": "ESP32-C6-MINI-1U with an external MHF III / W.FL antenna (a PCB antenna inside a metal box works poorly)",
    "noise": "none sensitive; 2 layers only, so no inner plane runs under 120 V copper",
    "build": "assembled by JLCPCB"
  },
  "libraries": {"footprints": {"smoke_bridge": "./lib/smoke_bridge.pretty"}},
  "board": {"width": 64, "height": 38, "layers": 2, "spacing": "compact"},
  "power_nets": "GND +5V +3V3 HLK_5V VBUS_IN AC_LF AC_N",
